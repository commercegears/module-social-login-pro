<?xml version="1.0"?>
<!--
    Adds the Pro providers to the Social Login section of Softaware Social Login (same section, same config paths
    softaware_sociallogin/<code>/..., same sort orders). Access is controlled by that section's ACL resource.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="softaware_sociallogin">
            <group id="apple" translate="label" type="text" sortOrder="110" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Apple</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment><model>Softaware\SocialLoginPro\Model\Config\Comment\AppleCallbackUrl</model></comment>
                </field>
                <field id="client_id" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Services ID</label>
                    <comment><![CDATA[The identifier of the Services ID, e.g. <code>com.example.shop.signin</code> (not the App ID).]]></comment>
                </field>
                <field id="team_id" translate="label comment" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Team ID</label>
                    <comment><![CDATA[10 letters and digits.]]></comment>
                    <validate>validate-alphanum minimum-length-10 maximum-length-10</validate>
                </field>
                <field id="key_id" translate="label comment" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Key ID</label>
                    <comment><![CDATA[10 letters and digits.]]></comment>
                    <validate>validate-alphanum minimum-length-10 maximum-length-10</validate>
                </field>
                <field id="private_key" translate="label comment" type="obscure" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Private Key (.p8)</label>
                    <comment><![CDATA[Paste the whole contents of the .p8 file, including the BEGIN/END lines. Stored encrypted.]]></comment>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
                <field id="label" translate="label comment" type="text" sortOrder="80" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Button Label</label>
                    <comment><![CDATA[Leave empty for "Continue with Apple".]]></comment>
                    <validate>validate-no-html-tags maximum-length-60</validate>
                </field>
                <field id="sort_order" translate="label comment" type="text" sortOrder="90" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Sort Order</label>
                    <validate>validate-digits validate-digits-range digits-range-0-9999</validate>
                </field>
            </group>
            <group id="microsoft" translate="label" type="text" sortOrder="130" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Microsoft</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment><model>Softaware\SocialLoginPro\Model\Config\Comment\MicrosoftCallbackUrl</model></comment>
                </field>
                <field id="client_id" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Application (client) ID</label>
                </field>
                <field id="client_secret" translate="label comment" type="obscure" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Client Secret</label>
                    <comment><![CDATA[Stored encrypted.]]></comment>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
                <field id="tenant" translate="label comment" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Tenant</label>
                    <comment><![CDATA[<code>common</code> (work, school and personal accounts), <code>consumers</code>, <code>organizations</code> or your tenant ID.]]></comment>
                </field>
                <field id="label" translate="label comment" type="text" sortOrder="80" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Button Label</label>
                    <comment><![CDATA[Leave empty for "Continue with Microsoft".]]></comment>
                    <validate>validate-no-html-tags maximum-length-60</validate>
                </field>
                <field id="sort_order" translate="label comment" type="text" sortOrder="90" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Sort Order</label>
                    <validate>validate-digits validate-digits-range digits-range-0-9999</validate>
                </field>
            </group>
            <group id="github" translate="label" type="text" sortOrder="140" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>GitHub</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment><model>Softaware\SocialLoginPro\Model\Config\Comment\GithubCallbackUrl</model></comment>
                </field>
                <field id="client_id" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Client ID</label>
                </field>
                <field id="client_secret" translate="label comment" type="obscure" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Client Secret</label>
                    <comment><![CDATA[Stored encrypted.]]></comment>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
                <field id="label" translate="label comment" type="text" sortOrder="80" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Button Label</label>
                    <comment><![CDATA[Leave empty for "Continue with GitHub".]]></comment>
                    <validate>validate-no-html-tags maximum-length-60</validate>
                </field>
                <field id="sort_order" translate="label comment" type="text" sortOrder="90" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Sort Order</label>
                    <validate>validate-digits validate-digits-range digits-range-0-9999</validate>
                </field>
            </group>
            <group id="linkedin" translate="label" type="text" sortOrder="150" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>LinkedIn</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment><model>Softaware\SocialLoginPro\Model\Config\Comment\LinkedinCallbackUrl</model></comment>
                </field>
                <field id="client_id" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Client ID</label>
                </field>
                <field id="client_secret" translate="label comment" type="obscure" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Client Secret</label>
                    <comment><![CDATA[Stored encrypted.]]></comment>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
                <field id="label" translate="label comment" type="text" sortOrder="80" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Button Label</label>
                    <comment><![CDATA[Leave empty for "Continue with LinkedIn".]]></comment>
                    <validate>validate-no-html-tags maximum-length-60</validate>
                </field>
                <field id="sort_order" translate="label comment" type="text" sortOrder="90" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Sort Order</label>
                    <validate>validate-digits validate-digits-range digits-range-0-9999</validate>
                </field>
            </group>
            <group id="amazon" translate="label" type="text" sortOrder="160" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Amazon</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment><model>Softaware\SocialLoginPro\Model\Config\Comment\AmazonCallbackUrl</model></comment>
                </field>
                <field id="client_id" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Client ID</label>
                </field>
                <field id="client_secret" translate="label comment" type="obscure" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Client Secret</label>
                    <comment><![CDATA[Stored encrypted.]]></comment>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
                <field id="label" translate="label comment" type="text" sortOrder="80" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Button Label</label>
                    <comment><![CDATA[Leave empty for "Continue with Amazon".]]></comment>
                    <validate>validate-no-html-tags maximum-length-60</validate>
                </field>
                <field id="sort_order" translate="label comment" type="text" sortOrder="90" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Sort Order</label>
                    <validate>validate-digits validate-digits-range digits-range-0-9999</validate>
                </field>
            </group>
        </section>
    </system>
</config>
